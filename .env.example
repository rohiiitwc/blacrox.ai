# BLACROX.AI SERVER CONFIGURATION
PORT=3000
NODE_ENV=development

# AUTHENTICATION & SESSIONS
# 2-hour (120 minutes) token lifetime
JWT_SECRET=blacrox_jwt_secure_random_key_production_grade
SESSION_EXPIRY_HOURS=2

# AI PROVIDER CREDENTIALS
# ChatGPT (OpenAI Vision API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Gemini (Google Generative AI Vision API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Grok (xAI Vision API)
GROK_API_KEY=
GROK_MODEL=grok-2-vision-1212

# MOCK SIMULATION FALLBACK (Set to true to allow testing without live API keys)
MOCK_AI_FALLBACK=true

